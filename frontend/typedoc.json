{
  "$schema": "https://typedoc.org/schema.json",
  "name": "ProjetoTP2 - Frontend",
  "entryPoints": ["src/components"],
  "entryPointStrategy": "expand",
  "tsconfig": "tsconfig.json",
  "out": "docs/api",
  "readme": "README.md",
  "excludePrivate": true,
  "excludeInternal": true,
  "treatWarningsAsErrors": true,
  "validation": {
    "notExported": true,
    "invalidLink": true
  }
}
